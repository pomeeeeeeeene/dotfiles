#!/bin/sh
set -eu

self=$0
case "$self" in
  */*) ;;
  *) self=$(command -v -- "$self" 2>/dev/null || printf '%s' "$self") ;;
esac
if [ -L "$self" ]; then
  target=$(readlink "$self")
  case "$target" in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
fi

repo_root=$(cd "$(dirname "$self")/.." && pwd)

if [ -z "${TMUX:-}" ] || [ -z "${TMUX_PANE:-}" ]; then
  exec kak "$@"
fi

tmux_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
safe_tmux_session=$(printf '%s' "$tmux_session" | sed 's/[^A-Za-z0-9._-]/_/g')
kak_session=kak-$safe_tmux_session

client_number=$(
  tmux list-panes -t "$TMUX_PANE" -F '#{pane_index} #{pane_id}' \
    | sort -n \
    | awk -v pane="$TMUX_PANE" '$2 == pane { print NR; exit }'
)
if [ -z "$client_number" ]; then
  echo "could not determine tmux pane position" >&2
  exit 1
fi

kak_client=ed-$client_number
tmux set-option -p -t "$TMUX_PANE" @kak_client "$kak_client"

expression="rename-client $kak_client"
if [ -f "$repo_root/kak/glow-sync.kak" ]; then
  expression="$expression; source '$repo_root/kak/glow-sync.kak'"
fi

export KAK_SESSION="$kak_session"
export KAK_SYNC_SCOPE="$safe_tmux_session"
exec kak -C "$kak_session" -e "$expression" "$@"
